{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "dist/web",
    "ignore": ["**/.*"],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" },
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "same-origin" }
        ]
      }
    ]
  }
}
