rules_version = '2';

// Only one account may read or write, and only under its own users/<uid>/ folder.
// The UID is the one shown in Firebase console → Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && uid == 'f9jZ0xFLO9fUoXxda3B7a98UrRK2';
    }
  }
}
